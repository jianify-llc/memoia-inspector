{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "memoia-inspector",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "env": {
    "test": {
      "name": "luvel-memoia-inspector-test",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "MEMOIA_BINDING_ORIGIN": "https://test-memoia.luvel.app" },
      "services": [{ "binding": "MEMOIA", "service": "luvel-memoia-test" }]
    }
  }
}
