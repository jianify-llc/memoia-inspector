# Root-path image uses same-origin requests. Set NEXT_PUBLIC_BASE_PATH only while building a custom image.

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL=""
# Optional: only a verified custom gateway may opt in with the literal true.
# Unset custom gateways stay in compatibility mode; the cache contract is not enabled.
OPENAI_PROMPT_CACHE_OPTIONS=""

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""

# Optional strict browser origin behind a proxy without Fetch Metadata (scheme + host + port).
INSPECTOR_PUBLIC_ORIGIN=""
